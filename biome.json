{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!catalogue", "!test/fixtures", "!package-lock.json", "!coverage"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120, "lineEnding": "lf" },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "overrides": [{ "includes": ["**/*.md"], "formatter": { "enabled": false } }],
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": { "noUndeclaredDependencies": "error" },
      "suspicious": { "noEvolvingTypes": "error", "noImportCycles": "error" },
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" },
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
