{
  "name": "@gizmos-quest/audacity-mcp",
  "version": "0.1.0",
  "description": "Safe local audio editing, analysis and production in Audacity 3.7 through mod-script-pipe",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gizmos-audacity-mcp": "dist/main.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:live": "node -e \"process.exit(require('node:child_process').spawnSync(process.execPath,['node_modules/vitest/vitest.mjs','run','--config','vitest.live.config.ts'],{stdio:'inherit',env:{...process.env,AUDACITY_LIVE:'1'}}).status ?? 1)\"",
    "catalogue": "tsx scripts/refresh-catalogue.ts",
    "parameters": "tsx scripts/source-parameters.ts",
    "start": "node dist/main.js",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test:unit": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:package": "node scripts/check-package.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e && npm run check:package"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "files": [
    "dist/",
    "catalogue/",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gizmos-quest/gizmos-audacity-mcp.git"
  },
  "homepage": "https://github.com/gizmos-quest/gizmos-audacity-mcp#readme",
  "bugs": {
    "url": "https://github.com/gizmos-quest/gizmos-audacity-mcp/issues"
  },
  "keywords": [
    "mcp",
    "audacity",
    "audio",
    "editing",
    "model-context-protocol"
  ],
  "mcpName": "io.github.gizmos-quest/gizmos-audacity-mcp",
  "publishConfig": {
    "access": "public"
  }
}
