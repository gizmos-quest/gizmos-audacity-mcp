{
  "name": "@gizmos-quest/gizmos-audacity-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives a running Audacity 3.x live through mod-script-pipe",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "gizmos-audacity-mcp": "dist/main.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "node -e \"process.exit(require('node:child_process').spawnSync(process.execPath,['node_modules/vitest/vitest.mjs','run','test/live.test.ts'],{stdio:'inherit',env:{...process.env,AUDACITY_LIVE:'1'}}).status ?? 1)\"",
    "catalogue": "tsx scripts/refresh-catalogue.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
